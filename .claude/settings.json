{
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    }
  },
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session_setup.sh",
            "async": true,
            "timeout": 600,
            "statusMessage": "Provisioning BidPilot deps (extras, cffi, LibreOffice)"
          }
        ]
      }
    ]
  }
}
